generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-arm64-openssl-3.0.x", "debian-openssl-3.0.x"]
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  CUSTOMER
  OPERATOR
}
enum QueueState {
  OPEN
  PAUSED
  CLOSED
}
enum EntryStatus {
  WAITING
  CALLED
  SERVING
  COMPLETED
  CANCELLED
  NO_SHOW
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(254)
  displayName String @map("display_name") @db.VarChar(100)
  passwordHash String @map("password_hash")
  role Role
  isActive Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  sessions Session[]
  entries QueueEntry[]
  events QueueEvent[]
  assignments OperatorQueueAssignment[]
  @@map("users")
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}
model Queue {
  id String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(8)
  name String @db.VarChar(100)
  state QueueState @default(OPEN)
  lastSequence BigInt @default(0) @map("last_sequence")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  entries QueueEntry[]
  assignments OperatorQueueAssignment[]
  @@map("queues")
}
model OperatorQueueAssignment {
  operatorId String @map("operator_id") @db.Uuid
  queueId String @map("queue_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  operator User @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  queue Queue @relation(fields: [queueId], references: [id], onDelete: Restrict)
  @@id([operatorId, queueId])
  @@index([queueId])
  @@map("operator_queue_assignments")
}
model QueueEntry {
  id String @id @default(uuid()) @db.Uuid
  queueId String @map("queue_id") @db.Uuid
  customerId String @map("customer_id") @db.Uuid
  sequence BigInt
  displayNumber String @unique @map("display_number") @db.VarChar(32)
  partySize Int @map("party_size") @db.SmallInt
  status EntryStatus @default(WAITING)
  joinedAt DateTime @default(now()) @map("joined_at") @db.Timestamptz(6)
  calledAt DateTime? @map("called_at") @db.Timestamptz(6)
  servingAt DateTime? @map("serving_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  cancelledAt DateTime? @map("cancelled_at") @db.Timestamptz(6)
  noShowAt DateTime? @map("no_show_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  queue Queue @relation(fields: [queueId], references: [id], onDelete: Restrict)
  customer User @relation(fields: [customerId], references: [id], onDelete: Restrict)
  events QueueEvent[]
  @@unique([queueId, sequence])
  @@index([queueId, status, sequence])
  @@index([customerId, joinedAt, id])
  @@map("queue_entries")
}
model QueueEvent {
  id String @id @default(uuid()) @db.Uuid
  entryId String @map("entry_id") @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  eventType String @map("event_type") @db.VarChar(40)
  fromStatus EntryStatus? @map("from_status")
  toStatus EntryStatus @map("to_status")
  occurredAt DateTime @default(now()) @map("occurred_at") @db.Timestamptz(6)
  reason String?
  entry QueueEntry @relation(fields: [entryId], references: [id], onDelete: Restrict)
  actor User? @relation(fields: [actorId], references: [id], onDelete: Restrict)
  @@index([entryId, occurredAt])
  @@index([actorId])
  @@map("queue_events")
}
